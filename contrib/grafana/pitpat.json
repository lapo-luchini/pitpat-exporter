{
  "title": "pitpat",
  "uid": "pitpat",
  "schemaVersion": 39,
  "editable": true,
  "graphTooltip": 1,
  "time": {
    "from": "now-7d",
    "to": "now"
  },
  "refresh": "30s",
  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "query": "prometheus",
        "label": "Data source",
        "current": {
          "text": "Prometheus",
          "value": "prometheus"
        },
        "options": []
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Speed (m/s)",
      "type": "timeseries",
      "gridPos": {
        "h": 9,
        "w": 16,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "expr": "pitpat_speed_meters_per_second",
          "refId": "A",
          "legendFormat": "belt"
        },
        {
          "expr": "pitpat_target_speed_meters_per_second",
          "refId": "B",
          "legendFormat": "target"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "mps",
          "min": 0
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 2,
      "title": "State",
      "type": "stat",
      "gridPos": {
        "h": 9,
        "w": 8,
        "x": 16,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "expr": "pitpat_state",
          "refId": "A",
          "legendFormat": "{{state}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none"
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "textMode": "auto",
        "graphMode": "area"
      }
    },
    {
      "id": 3,
      "title": "Distance per day",
      "type": "barchart",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 7,
        "w": 6,
        "x": 0,
        "y": 9
      },
      "targets": [
        {
          "expr": "increase(pitpat_distance_meters_total[1d])",
          "refId": "A",
          "legendFormat": "Distance per day"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "m"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 4,
      "title": "Steps per day",
      "type": "barchart",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 7,
        "w": 6,
        "x": 6,
        "y": 9
      },
      "targets": [
        {
          "expr": "increase(pitpat_steps_total[1d])",
          "refId": "A",
          "legendFormat": "Steps per day"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": ""
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 5,
      "title": "Active minutes per day",
      "type": "barchart",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 7,
        "w": 6,
        "x": 12,
        "y": 9
      },
      "targets": [
        {
          "expr": "increase(pitpat_moving_seconds_total[1d]) / 60",
          "refId": "A",
          "legendFormat": "Active minutes per day"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 6,
      "title": "Lifetime walked (km)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 7,
        "w": 6,
        "x": 18,
        "y": 9
      },
      "targets": [
        {
          "expr": "pitpat_distance_meters_total",
          "refId": "A",
          "legendFormat": "Lifetime walked (km)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "m"
        },
        "overrides": []
      },
      "options": {}
    }
  ]
}
