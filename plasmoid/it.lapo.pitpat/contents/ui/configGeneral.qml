import QtQuick 2.15
import QtQuick.Controls as QQC
import org.kde.kirigami as Kirigami

/**
 * Config page (§10): daemon URL, token, milestone km (0 = off), show speed
 * in panel. The `cfg_*` property naming is what the configuration dialog
 * wires to the KConfigXT keys automatically.
 */
Kirigami.FormLayout {
    id: general

    // auto-generated by the configuration dialog from main.xml
    property string cfg_daemonUrl: Plasmoid.configuration.daemonUrl
    property string cfg_token: Plasmoid.configuration.token
    property double cfg_milestoneKm: Plasmoid.configuration.milestoneKm
    property bool cfg_showSpeedInPanel: Plasmoid.configuration.showSpeedInPanel

    Kirigami.InlineMessage {
        Layout.fillWidth: true
        visible: content.length > 0
        text: i18n("Requires `.desktop`? No — this plasmoid talks plain HTTP.")
    }
    QQC.TextField {
        id: daemonUrlField
        text: general.cfg_daemonUrl
        placeholderText: "http://127.0.0.1:9839"
        onTextChanged: cfg_daemonUrl = text
        validator: RegularExpressionValidator {
            regularExpression: /^https?:\/\/[A-Za-z0-9.\-:__]+$/id
        }
        Kirigami.FormData.label: i18n("Daemon URL:")
    }
    QQC.TextField {
        text: general.cfg_token
        echoMode: TextInput.Password
        onTextChanged: cfg_token = text
        Kirigami.FormData.label: i18n("API token:")
        Kirigami.FormData.checkable: false
    }
    QQC.SpinBox {
        id: milestoneSpin
        from: 0
        to: 100
        value: cfg_milestoneKm
        // decimals 2
        editable: true
        property real km: 0
        stepSize: 1
        onValueModified: general.cfg_milestoneKm = value
        textFromValue: function (value, locale) {
            return Number(value).toFixed(2);
        }
        valueFromText: function (text, locale) {
            return Number.fromLocaleString(locale, text);
        }
        Kirigami.FormData.label: i18n("Milestone every X km (0 = off):")
    }
    QQC.CheckBox {
        text: i18n("Show speed in panel")
        checked: general.cfg_showSpeedInPanel
        onToggled: general.cfg_showSpeedInPanel = checked
    }
}
